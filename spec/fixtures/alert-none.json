{
  "description": "Nothing crosses a threshold -> no alerts fire",
  "snapshot": {
    "model": "claude-opus-4-8",
    "context": { "usedTokens": 10000, "limitTokens": 100000 },
    "quota": { "windows": [{ "label": "Claude weekly", "usedPct": 10 }] },
    "route": { "sessionKey": "s1" }
  },
  "config": {
    "alerts": {
      "context": { "enabled": true, "thresholdPct": 80 },
      "budget": { "enabled": true, "thresholdPct": 20 }
    }
  }
}
